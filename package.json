{
  "name": "wavescan-site",
  "private": true,
  "version": "0.1.0",
  "description": "The website for Wavescan, the Wuthering Waves echo scanner.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
